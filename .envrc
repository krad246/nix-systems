#!/usr/bin/env bash
# strict_env

shopt -s globstar

TMPDIR="$(readlink -f "$TMPDIR")"
export TMPDIR

watch_dir ./flakeModules

devShell=".#interactive"

# A new worktree must be able to create its first nix-direnv cache. Once this
# exact devShell has a cache, retain the deliberate manual-reload policy so
# watched source changes do not cause reload churn.
if type nix_direnv_manual_reload >/dev/null; then
  layout_dir="$(direnv_layout_dir)"
  profile="${layout_dir}/flake-profile$(_nix_argsum_suffix "$devShell")"
  if [[ -e $profile && -e "${profile}.rc" ]]; then
    nix_direnv_manual_reload
  fi
fi

use flake "$devShell" \
  --option experimental-features 'nix-command flakes' \
  --option accept-flake-config true \
  --option show-trace true \
  --option connect-timeout 120 \
  --option timeout 120 \
  --option max-silent-time 180 \
  --fallback
